{
  "name": "memorybook-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "migrate:wedding": "tsx server/wedding/migrate-cli.ts",
    "test:wedding": "tsx --test tests/wedding.test.ts",
    "test:full-flow": "tsx --test tests/full-flow.test.ts",
    "pilot:wedding": "tsx scripts/wedding-pilot.ts",
    "start:internet-pilot": "tsx server/pilot/index.ts",
    "test:internet-pilot": "tsx --test tests/internet-pilot.test.ts",
    "invite:internet-pilot": "tsx scripts/pilot-owner-invite.ts",
    "test:wedding-photo": "tsx --test tests/wedding-photo.test.ts tests/wedding-photo-browser.test.ts",
    "test:mcp": "tsx --test --test-force-exit tests/book-workflow.test.ts tests/mcp.test.ts tests/mcp-allowlist.test.ts",
    "test:content-review": "tsx --test --test-force-exit tests/content-review.test.ts tests/content-review-workflow.test.ts tests/content-review-bypass.test.ts tests/mcp-internet-review.test.ts",
    "test:content-review-browser": "tsx --test --test-force-exit tests/content-review-browser.test.ts",
    "test:guest-media": "tsx --test --test-force-exit tests/av-media.test.ts tests/av-workflow.test.ts tests/wedding-photo.test.ts",
    "test:guest-media-browser": "tsx --test --test-force-exit tests/guest-media-browser.test.ts tests/wedding-photo-browser.test.ts tests/wedding-drawing-browser.test.ts",
    "test:mcp-browser": "tsx --test --test-force-exit tests/mcp-book-browser.test.ts tests/montage-browser.test.ts",
    "test:mcp-browser:chromium": "tsx --test --test-force-exit --test-name-pattern=\"MCP owner|chromium\" tests/mcp-book-browser.test.ts tests/montage-browser.test.ts",
    "test:pilot-regression": "tsx --test --test-force-exit --test-timeout=120000 tests/wedding.test.ts tests/internet-pilot.test.ts tests/wedding-photo.test.ts tests/pilot-commerce.test.ts tests/full-flow.test.ts tests/pilot-startup.test.ts tests/wedding-photo-browser.test.ts tests/wedding-drawing-browser.test.ts tests/pilot-shop-browser.test.ts",
    "pilot:mcp": "tsx scripts/mcp-local-demo.ts"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/qrcode": "^1.5.5",
    "better-auth": "^1.7.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fabric": "^7.4.0",
    "ffmpeg-static": "5.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "saxes": "6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
